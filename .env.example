# NorthStack Digitals — Environment Variables Template

# Public Domain & Base URL
NEXT_PUBLIC_BASE_URL="https://northstackdigitals.vercel.app"
NEXT_PUBLIC_APP_URL="https://northstackdigitals.vercel.app"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skyline_dev?schema=public"

# Gmail SMTP Email & OTP Service
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_16_char_app_password"
APP_NAME="Google Gmail send for NorthStack Digitals"

# GitHub OAuth App
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google OAuth 2.0 / OpenID Connect Client
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Microsoft / Azure AD App
MICROSOFT_CLIENT_ID="your_microsoft_client_id"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret"
MICROSOFT_TENANT_ID="common"

# Session & Token Security
AUTH_SECRET="your_auth_secret_minimum_32_characters"
JWT_SECRET="your_jwt_secret_minimum_32_characters"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="xxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxx"
