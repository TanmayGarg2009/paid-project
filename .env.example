# ==============================================================================
# SKYLINE DIGITAL SERVICES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | staging | production | test)
NODE_ENV=development

# Web Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://skyline_user:skyline_pass@localhost:5432/skyline_db?schema=public"

# Cache & Message Queue (Redis)
REDIS_URL="redis://localhost:6379"

# Authentication Secrets (Generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-cryptographically-secure-32-char-random-secret"
ADMIN_SESSION_SECRET="replace-with-another-secure-32-char-secret-for-admin"

# Default Admin Credentials (Seed / Bootstrap)
DEFAULT_ADMIN_EMAIL="admin@skyline.dev"
DEFAULT_ADMIN_PASSWORD="SkylineAdminPassword2026!"
DEFAULT_ADMIN_NAME="Skyline Owner"

# Razorpay Payment Gateway (Test Mode for Development)
# Get keys from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="YourTestKeySecret"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretForSignatureVerification"

# Object Storage (S3 / Cloudflare R2 / Supabase Storage)
# Leave blank to fallback to secure local filesystem storage in development
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="skyline-assets"
STORAGE_PUBLIC_URL=""

# Transactional Email (Resend / Brevo / SMTP)
EMAIL_FROM="Skyline <notifications@skyline.dev>"
RESEND_API_KEY="re_dummy_test_key_for_dev"
SMTP_URL="smtp://user:pass@smtp.mailtrap.io:2525"

# Discord Operations Bot & Webhooks
DISCORD_BOT_TOKEN="your_discord_bot_token_from_developer_portal"
DISCORD_CLIENT_ID="your_discord_application_client_id"
DISCORD_GUILD_ID="your_skyline_team_discord_server_id"
DISCORD_ALERTS_CHANNEL_ID="your_alerts_channel_id"
DISCORD_OPS_WEBHOOK_URL="https://discord.com/api/webhooks/dummy/webhook_url"

# Security & Bot Protection (Cloudflare Turnstile — Optional in Dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Observability (Sentry — Optional in Dev)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
